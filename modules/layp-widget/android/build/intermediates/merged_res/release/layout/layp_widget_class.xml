<?xml version="1.0" encoding="utf-8"?>
<!-- Today's Classes widget. Rows wrap their content (no fixed heights) and the
     provider shows only as many as the launcher gives room for, so nothing
     is clipped at 2x2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layp_class_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/layp_widget_glass_dark">

  <LinearLayout
      android:id="@+id/layp_class_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="26dp"
      android:gravity="center_vertical"
      android:paddingStart="2dp"
      android:paddingEnd="2dp">
    <TextView
        android:id="@+id/layp_class_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Classes"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:textSize="13sp"
        android:includeFontPadding="false"
        android:maxLines="1" />
    <TextView
        android:id="@+id/layp_class_header_state"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="#D9FFFFFF"
        android:textSize="9sp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:background="@drawable/layp_class_pill"
        android:maxLines="1" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/layp_class_rows"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layp_class_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/layp_class_row_highlight">
      <ViewFlipper
          android:id="@+id/layp_class_blink_0"
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:autoStart="true"
          android:flipInterval="1000"
          android:inAnimation="@anim/layp_class_blink_in"
          android:outAnimation="@anim/layp_class_blink_out"
          android:visibility="gone">
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#1F66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
      </ViewFlipper>
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="4dp"
          android:paddingEnd="4dp">
        <TextView android:id="@+id/layp_class_name_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/layp_class_meta_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
      <TextView
          android:id="@+id/layp_class_action_0"
          android:layout_width="wrap_content"
          android:layout_height="26dp"
          android:gravity="center"
          android:paddingStart="9dp"
          android:paddingEnd="9dp"
          android:text="Cancel"
          android:textColor="#FFB4AF"
          android:textSize="10sp"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:background="@drawable/layp_class_action"
          android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layp_class_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/layp_class_row">
      <ViewFlipper
          android:id="@+id/layp_class_blink_1"
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:autoStart="true"
          android:flipInterval="1000"
          android:inAnimation="@anim/layp_class_blink_in"
          android:outAnimation="@anim/layp_class_blink_out"
          android:visibility="gone">
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#1F66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
      </ViewFlipper>
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="4dp"
          android:paddingEnd="4dp">
        <TextView android:id="@+id/layp_class_name_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/layp_class_meta_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
      <TextView
          android:id="@+id/layp_class_action_1"
          android:layout_width="wrap_content"
          android:layout_height="26dp"
          android:gravity="center"
          android:paddingStart="9dp"
          android:paddingEnd="9dp"
          android:text="Cancel"
          android:textColor="#FFB4AF"
          android:textSize="10sp"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:background="@drawable/layp_class_action"
          android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layp_class_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/layp_class_row">
      <ViewFlipper
          android:id="@+id/layp_class_blink_2"
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:autoStart="true"
          android:flipInterval="1000"
          android:inAnimation="@anim/layp_class_blink_in"
          android:outAnimation="@anim/layp_class_blink_out"
          android:visibility="gone">
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#1F66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
      </ViewFlipper>
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="4dp"
          android:paddingEnd="4dp">
        <TextView android:id="@+id/layp_class_name_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/layp_class_meta_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
      <TextView
          android:id="@+id/layp_class_action_2"
          android:layout_width="wrap_content"
          android:layout_height="26dp"
          android:gravity="center"
          android:paddingStart="9dp"
          android:paddingEnd="9dp"
          android:text="Cancel"
          android:textColor="#FFB4AF"
          android:textSize="10sp"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:background="@drawable/layp_class_action"
          android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layp_class_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/layp_class_row">
      <ViewFlipper
          android:id="@+id/layp_class_blink_3"
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:autoStart="true"
          android:flipInterval="1000"
          android:inAnimation="@anim/layp_class_blink_in"
          android:outAnimation="@anim/layp_class_blink_out"
          android:visibility="gone">
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
        <TextView android:layout_width="10dp" android:layout_height="10dp" android:gravity="center" android:text="●" android:textColor="#1F66D7FF" android:textSize="8sp" android:includeFontPadding="false" />
      </ViewFlipper>
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="4dp"
          android:paddingEnd="4dp">
        <TextView android:id="@+id/layp_class_name_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/layp_class_meta_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
      <TextView
          android:id="@+id/layp_class_action_3"
          android:layout_width="wrap_content"
          android:layout_height="26dp"
          android:gravity="center"
          android:paddingStart="9dp"
          android:paddingEnd="9dp"
          android:text="Cancel"
          android:textColor="#FFB4AF"
          android:textSize="10sp"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:background="@drawable/layp_class_action"
          android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/layp_class_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
