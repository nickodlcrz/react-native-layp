<?xml version="1.0" encoding="utf-8"?>
<!-- Right pane, later pages: one upcoming event on the navy gradient. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layp_cal_event_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/layp_widget_glass_panel_dark">

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <ImageView
        android:id="@+id/layp_cal_event_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/layp_widget_dot" />

    <TextView
        android:id="@+id/layp_cal_event_kind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp"
        android:letterSpacing="0.06"
        android:maxLines="1" />
  </LinearLayout>

  <TextView
      android:id="@+id/layp_cal_event_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:fontFamily="sans-serif-medium"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:maxLines="3"
      android:ellipsize="end" />

  <TextView
      android:id="@+id/layp_cal_event_when"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:textColor="#B3FFFFFF"
      android:textSize="12sp"
      android:maxLines="2" />

  <TextView
      android:id="@+id/layp_cal_event_extra"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:fontFamily="sans-serif-medium"
      android:textColor="#FFFFFF"
      android:textSize="12sp"
      android:maxLines="1" />
</LinearLayout>
