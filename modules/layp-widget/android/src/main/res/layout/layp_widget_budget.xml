<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/layp_budget_root" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/layp_widget_glass_dark" android:padding="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:paddingBottom="6dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
      <TextView android:id="@+id/layp_budget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total budget · all accounts" android:textColor="#CCFFFFFF" android:textSize="11sp" />
      <TextView android:id="@+id/layp_budget_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <TextView android:id="@+id/layp_budget_privacy" android:layout_width="56dp" android:layout_height="36dp" android:gravity="center" android:text="Hide" android:textColor="#DBE4FF" android:textSize="12sp" android:background="@drawable/layp_widget_chip_bg_dark" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <GridView android:id="@+id/layp_budget_grid" android:layout_width="match_parent" android:layout_height="match_parent" android:numColumns="2" android:horizontalSpacing="8dp" android:verticalSpacing="6dp" android:stretchMode="columnWidth" android:scrollbars="none" />
    <TextView android:id="@+id/layp_budget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#CCFFFFFF" android:textSize="12sp" />
  </FrameLayout>
</LinearLayout>
