<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/layp_widget_glass_dark" android:padding="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
    <TextView android:id="@+id/layp_budget_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Account budget" android:textColor="#FFFFFF" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/layp_budget_privacy" android:layout_width="56dp" android:layout_height="36dp" android:gravity="center" android:text="Hide" android:textColor="#DBE4FF" android:textSize="12sp" android:background="@drawable/layp_widget_chip_bg_dark" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <GridView android:id="@+id/layp_budget_grid" android:layout_width="match_parent" android:layout_height="match_parent" android:numColumns="2" android:horizontalSpacing="8dp" android:verticalSpacing="6dp" android:stretchMode="columnWidth" android:scrollbars="vertical" />
    <TextView android:id="@+id/layp_budget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#CCFFFFFF" android:textSize="12sp" />
  </FrameLayout>
</LinearLayout>
