<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/layp_class_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="6dp" android:layout_marginBottom="3dp" android:background="@drawable/layp_class_row">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:id="@+id/layp_class_row_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:includeFontPadding="false" />
    <TextView android:id="@+id/layp_class_row_cancel" android:layout_width="wrap_content" android:layout_height="28dp" android:paddingHorizontal="6dp" android:gravity="center" android:text="Cancel" android:textSize="9sp" android:textColor="#FFB4AF" android:background="@drawable/layp_class_action" />
  </LinearLayout>
  <TextView android:id="@+id/layp_class_row_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#DBFFFFFF" android:includeFontPadding="false" />
  <TextView android:id="@+id/layp_class_row_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#BFFFFFFF" />
</LinearLayout>
