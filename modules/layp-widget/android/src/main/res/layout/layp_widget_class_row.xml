<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp">
  <LinearLayout android:id="@+id/layp_class_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/layp_class_row">
    <TextView android:id="@+id/layp_class_row_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:includeFontPadding="false" />
    <TextView android:id="@+id/layp_class_row_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="11sp" android:textColor="#DBFFFFFF" android:includeFontPadding="false" />
    <TextView android:id="@+id/layp_class_row_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textColor="#BFFFFFFF" />
    <TextView android:id="@+id/layp_class_row_cancel" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_gravity="end" android:layout_marginTop="7dp" android:paddingHorizontal="9dp" android:gravity="center" android:text="Cancel" android:textSize="9sp" android:textColor="#FFB4AF" android:background="@drawable/layp_class_action" />
  </LinearLayout>
</LinearLayout>
