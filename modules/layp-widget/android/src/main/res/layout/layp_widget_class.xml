<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/layp_class_square" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/layp_class_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/layp_widget_glass_dark">
    <LinearLayout android:id="@+id/layp_class_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="4dp">
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Classes today" android:textSize="12sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
      <TextView android:id="@+id/layp_class_header_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#BFFFFFFF" android:includeFontPadding="false" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <ListView android:id="@+id/layp_class_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:scrollbars="none" />

      <TextView android:id="@+id/layp_class_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#CCFFFFFF" android:textSize="12sp" android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
