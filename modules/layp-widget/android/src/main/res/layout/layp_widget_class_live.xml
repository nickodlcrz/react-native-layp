<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:background="@drawable/layp_class_row_live">
  <TextView android:id="@+id/layp_class_live_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:includeFontPadding="false" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="is ongoing right now" android:textSize="10sp" android:textColor="#CFFFFFFF" android:includeFontPadding="false" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Ends in" android:textSize="9sp" android:textColor="#BFFFFFFF" android:layout_marginTop="9dp" android:includeFontPadding="false" />
  <Chronometer android:id="@+id/layp_class_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:textSize="24sp" android:textColor="#9CE8CC" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
  <TextView android:id="@+id/layp_class_live_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="10sp" android:textColor="#DBFFFFFF" android:layout_marginTop="9dp" />
  <TextView android:id="@+id/layp_class_live_cancel" android:layout_width="wrap_content" android:layout_height="30dp" android:paddingHorizontal="10dp" android:layout_marginTop="10dp" android:gravity="center" android:text="Cancel class" android:textSize="10sp" android:textColor="#FFB4AF" android:background="@drawable/layp_class_action" />
</LinearLayout>
